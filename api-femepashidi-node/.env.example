# Puerto del servidor (Railway lo inyecta automáticamente en producción)
PORT=3000

# URL base del propio servidor
SERVER=http://localhost:3000

# URL del panel de gestión (app-femepashidi-react), usada en CORS y enlaces de correo
URL_APP=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DATABASE=femepashidi

# JWT
JWT_SECRET=your_jwt_secret_here

# Envío de correos
HOST_EMAIL_SUPPORT=smtp.example.com
PORT_EMAIL_SUPPORT=587
EMAIL_SUPPORT=your_email@example.com
PASS_EMAIL_SUPPORT=your_app_password_here
MAIL_FROM=no-reply@femepashidi.com

# Resend (opcional, si se usa como proveedor de correo)
APIKEY_RESEND=
